# ─────────────────────────────────────────
#  API Server Environment Variables
#  Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────

# App configuration
APP_NAME=SmartHire API Server
APP_ENV=production

# API service configuration
API_HOST=0.0.0.0
API_PORT=5000
WORKERS=4

# MongoDB - must match MONGO_ROOT_USERNAME/PASSWORD in the root .env
MONGO_URL=mongodb://root:CHANGE_ME_PASSWORD@mongo_db:27017/db_local?authSource=admin
MONGO_TEST_URL=mongodb://root:CHANGE_ME_PASSWORD@mongo_db:27017/db_test?authSource=admin&retryWrites=true&w=majority

# AI Engine
AI_ENGINE_URL=http://ai_engine:7000

# Security - generate a random key with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-key-here

# APP configuration
APP_NAME=Flask API Rest Template
APP_ENV=local
FLASK_APP=app:app

# Flask Configuration
API_ENTRYPOINT=app:app
APP_SETTINGS_MODULE=config.LocalConfig
APP_TEST_SETTINGS_MODULE=config.TestingConfig

# API service configuration
API_HOST=0.0.0.0
API_PORT=5000

# Database
# Use your own MongoDB connection string here
MONGO_URL=mongodb://username:password@localhost:27017/db_name?authSource=admin
MONGO_TEST_URL=mongodb://username:password@localhost:27017/db_test?authSource=admin

# Analysis service url
ANALYSIS_SERVICE_URL=http://localhost:7000

# Secret app
SECRET_KEY=your-secret-key-change-me

# ─────────────────────────────────────────
#  SmartHire — Docker Compose Environment
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────

# MongoDB credentials (change these before any real use)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_strong_password_here

# Nginx external port (default: 8080)
NGINX_PORT=8080
